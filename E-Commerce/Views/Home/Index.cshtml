@model List<Product>
@{
    ViewData["Title"] = "Home Page";
    ViewData["HomePage"] = true;
}

<div style="background-color:midnightblue">
    <div class="container text-white py-5">
        <div class="row align-items-center g-5">
            <div class="col-md-6">
                <h1 class="mb-5 display-2"> <strong>Best Store of Electronics</strong> </h1>
                <p>
                    Find a larage selection of electronics products at Best Store.
                    From the latest smartphones and laptops to home appliances and accessories,
                    we have everything you need to stay connected and entertained.
                    Shop with confidence and enjoy fast shipping and excellent customer service.
                </p>
            </div>
            <div class="col-md-6 text-center">
                <img src="/images/hero.png" class="img-fluid" alt="hero" />
            </div>
        </div>

    </div>
</div>
<div class="bg-light">
    <div class="container py-4">
        <h2 class="pb-4 text-center">
            Newest Products
        </h2>
        <div class="row mb-5 g-3">
            @foreach (var item in Model)
            {
                <div class="col-lg-3 col-md-6">
                    <div class="rounded border shadow p-3 text-center h-100">
                        <img src="/products/@item.ImageFileName" class="img-fluid" alt="..."
                             style="height :180px;object-fit:contain" />
                        <hr />
                        <h5 class="py-2">@item.Name</h5>
                        <p>Brand :@item.Brand, Category : @item.Category</p>
                        <h4 class="mb-3">@(item.Price)$</h4>
                        <a class="btn btn-primary btn-sm mb-2" role="button" asp-controller="Store" asp-action="Details" asp-route-id="@item.Id">Details</a>
                        <button type="button" class="btn btn-warning btn-sm mb-2" onclick="addToCart(this,@item.Id)">Add to Cart <i class="bi bi-cart4"></i></button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
