</head>
<body>

    <script>
        // Get shopping cart from cookie
        function getShoppingCart() {
            try {
                const cookieName = "shopping_cart=";
                const cookies = document.cookie.split(';');

                for (let i = 0; i < cookies.length; i++) {
                    const cookie = cookies[i].trim();
                    if (cookie.startsWith(cookieName)) {
                        const cartStr = cookie.substring(cookieName.length);
                        const decodedStr = decodeURIComponent(cartStr);
                        const cart = JSON.parse(decodedStr);
                        return cart;
                    }
                }
            } catch (e) {
                console.error("Error reading cart cookie:", e);
            }
            return {};
        }

        // Save shopping cart to cookie
        function saveCart(cart) {
            try {
                const cartStr = JSON.stringify(cart);
                const encodedStr = encodeURIComponent(cartStr);

                const date = new Date();
                date.setDate(date.getDate() + 365);

                document.cookie = `shopping_cart=${encodedStr};expires=${date.toUTCString()};path=/`;
                console.log("Cart saved:", cart);
            } catch (e) {
                console.error("Error saving cart:", e);
            }
        }

        // Update cart badge display
        function updateCartDisplay() {
            const cart = getShoppingCart();
            let totalItems = 0;

            for (const [productId, quantity] of Object.entries(cart)) {
                const qty = parseInt(quantity) || 0;
                totalItems += qty;
            }

            const badge = document.getElementById("CartSize");
            if (badge) {
                badge.textContent = totalItems;
            }

            console.log("Cart updated. Total items:", totalItems);
        }

        // Add item to cart
        function addToCart(button, id) {
            console.log("Adding product ID:", id);

            // Get current cart
            const cart = getShoppingCart();

            // Get current quantity for this product
            let quantity = parseInt(cart[id]) || 0;

            // Increment quantity
            quantity++;
            cart[id] = quantity;

            // Save updated cart
            saveCart(cart);

            // Update button state
            button.textContent = "Added";
            button.disabled = true;

            // Reset button after 2 seconds
            setTimeout(() => {
                button.textContent = "Add to Cart";
                button.disabled = false;
            }, 2000);

            // Update cart display
            updateCartDisplay();
        }

        // Initialize cart on page load
        document.addEventListener("DOMContentLoaded", function() {
            console.log("Page loaded - initializing cart");
            updateCartDisplay();
        });

    </script>


