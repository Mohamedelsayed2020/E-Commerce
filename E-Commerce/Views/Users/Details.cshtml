@model ApplicationUser
@{
}

<div class="row">
    <div class="col-lg-6 mx-auto rounded border p-4">
        <h2 class="text-center mb-3">
            Users Details
        </h2>
        <hr />
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>
                    @TempData["ErrorMessage"]
                </strong>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        else if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <strong>
                    @TempData["SuccessMessage"]
                </strong>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <div class="row mb-2">
            <label class="col-sm-4 col-form-label">First Name</label>
            <div class="col-sm-8">
                <input class="form-control" readonly value="@Model.FirstNme" />
            </div>
        </div>

        <div class="row mb-2">
            <label class="col-sm-4 col-form-label">Last Name</label>
            <div class="col-sm-8">
                <input class="form-control" readonly value="@Model.LastName" />
            </div>
        </div>

        <div class="row mb-2">
            <label class="col-sm-4 col-form-label">Email</label>
            <div class="col-sm-8">
                <input class="form-control" readonly value="@Model.Email" />
            </div>
        </div>
        <div class="row mb-2">
            <label class="col-sm-4 col-form-label">Phone</label>
            <div class="col-sm-8">
                <input class="form-control" readonly value="@Model.PhoneNumber" />
            </div>
        </div>

        <div class="row mb-2">
            <label class="col-sm-4 col-form-label">Address</label>
            <div class="col-sm-8">
                <input class="form-control" readonly value="@Model.Address" />
            </div>
        </div>
        <div class="row mb-2">
            <label class="col-sm-4 col-form-label">Role</label>
            <div class="col-sm-8">
                @{
                    var roles = ViewBag.Roles;
                    var rolesStr = String.Join(", ", roles);
                    string color = "bg-secondary";
                    if (roles.Contains("admin"))
                    {
                        color = " bg-danger";
                    }
                    if (roles.Contains("seller"))
                    {
                        color = " bg-warning text-dark";
                    }
                    if (roles.Contains("client"))
                    {
                        color = " bg-info text-dark";
                    }
                    <span class="badge rounded-pill @color">@rolesStr</span>
                    <button type="button" class="btn btn-link" data-bs-toggle="modal" data-bs-target="#roleModal">
                        Edit
                    </button>
                }
            </div>
        </div>
        <div class="row mb-2">
            <label class="col-sm-4 col-form-label">Created At</label>
            <div class="col-sm-8">
                <input class="form-control" readonly value="@Model.CreatedAt" />
            </div>
        </div>

        <hr />

        <div class="row mb-2">
            <div class="col-sm-12 text-center">
                <a class="btn btn-secondary" asp-controller="Users" asp-action="Index">Back to List</a>
                <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal" >Delete </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="roleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" >Edit User Role</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form method="get" asp-controller="Users" asp-action="EditRole">

                    <input type="hidden" name="id" value="@Model.Id" />
                    <label for="roleSelect">Select Role:</label>
                    <select class="form-select mb-2" asp-items="@ViewBag.SelectItems" name="newRole">
                    </select>
                    <button type="submit" class="btn btn-primary">Save</button>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


<!-- Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1"  aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" >Delete User Account</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this user account ? </p>
            </div>
            <div class="modal-footer">
                <a class="btn btn-danger" role="button" asp-controller="Users" asp-action="DeleteAccount" asp-route-id="@Model.Id">Delete</a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
